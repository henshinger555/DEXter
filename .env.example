# Comma-separated games to load at startup. Names are the {tcg} URL segment;
# see src/dexter/games.py for the list.
DEXTER_GAMES=pokemon

# Matches returned per request (1 best + the rest as alternatives).
DEXTER_TOP_K=5

# Detector sharpness below which the response reports no card (0 disables).
DEXTER_MIN_SHARPNESS=0.02

# Largest accepted upload in bytes (10 MiB).
DEXTER_MAX_UPLOAD_BYTES=10485760

# ONNX Runtime threads per model and provider preference (auto, cpu, gpu).
DEXTER_NUM_THREADS=4
DEXTER_PROVIDER=auto

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
DEXTER_CORS_ORIGINS=

# Bind address and port for the `dexter` command.
DEXTER_HOST=127.0.0.1
DEXTER_PORT=8000

# Where models and catalogs are downloaded. Defaults to ~/.cache/collectorvision.
#DEXTER_CACHE_DIR=/var/lib/dexter/cache
